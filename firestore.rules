rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow application collections read and write for TFG Management App operations
    match /config/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    match /clients/{clientId} {
      allow read, write: if true;
    }

    match /client_subscriptions/{subId} {
      allow read, write: if true;
    }

    match /packages/{pkgId} {
      allow read, write: if true;
    }

    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    match /cafe_shifts/{shiftId} {
      allow read, write: if true;
    }

    match /cafe_orders/{orderId} {
      allow read, write: if true;
    }

    match /inventory/{itemId} {
      allow read, write: if true;
    }

    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    match /ticket_sales/{saleId} {
      allow read, write: if true;
    }

    match /vouchers/{voucherId} {
      allow read, write: if true;
    }

    match /admin_revenues/{revId} {
      allow read, write: if true;
    }

    match /admin_expenses/{expId} {
      allow read, write: if true;
    }

    match /attendance/{attId} {
      allow read, write: if true;
    }

    match /instructors/{instId} {
      allow read, write: if true;
    }

    match /course_schedules/{schedId} {
      allow read, write: if true;
    }

    match /salaries/{salId} {
      allow read, write: if true;
    }

    match /assets/{assetId} {
      allow read, write: if true;
    }

    match /contracts/{contractId} {
      allow read, write: if true;
    }

    match /lost_and_found/{itemId} {
      allow read, write: if true;
    }

    match /feedback/{fbId} {
      allow read, write: if true;
    }

    match /customer_service_requests/{reqId} {
      allow read, write: if true;
    }

    match /partner_transactions/{txId} {
      allow read, write: if true;
    }

    match /wallet_transactions/{txId} {
      allow read, write: if true;
    }

    match /loyalty/{docId} {
      allow read, write: if true;
    }

    match /announcements/{docId} {
      allow read, write: if true;
    }

    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    match /active_sessions/{sessId} {
      allow read, write: if true;
    }

    match /system_diagnostics/{diagId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
